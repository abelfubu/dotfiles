#!/bin/bash
# Trigger: {{ include "dot_config/herdr/config.toml" | sha256sum }}
set -e

if ! command -v herdr >/dev/null 2>&1; then
  echo "herdr not found, skipping plugin setup"
  exit 0
fi

if ! herdr plugin list --json | grep -q '"plugin_id":"herdr-splits"'; then
  echo "Installing herdr-splits plugin..."
  herdr plugin install lmilojevicc/herdr-splits.nvim --yes
else
  echo "herdr-splits plugin already installed"
fi

if ! herdr plugin list --json | grep -q '"plugin_id":"persiyanov.reviewr"'; then
  echo "Installing reviewr plugin..."
  herdr plugin install persiyanov/herdr-reviewr --yes
else
  echo "reviewr plugin already installed"
fi

if ! herdr plugin list --json | grep -q '"plugin_id":"herdr-popup"'; then
  echo "Installing herdr-popup plugin..."
  herdr plugin install abelfubu/herdr-popup --yes
else
  echo "herdr-popup plugin already installed"
fi

herdr server reload-config || true
