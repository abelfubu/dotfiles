{
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "left",
    "default_model": { "provider": "copilot_chat", "model": "gpt-4.1" },
    "default_width": 600,
  },
  "buffer_font_family": "Geist Mono",
  "buffer_font_size": 15,
  "buffer_font_weight": 300,
  "buffer_line_height": { "custom": 2.3 },
  "cursor_blink": false,
  "format_on_save": "on",
  "git_panel": { "dock": "left", "default_width": 600 },
  "hide_mouse": "on_typing_and_action",
  "indent_guides": { "enabled": false },
  "outline_panel": { "dock": "right" },
  "preview_tabs": { "enabled": true },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "indent_size": 16,
    "sticky_scroll": false,
    "indent_guides": { "show": "never" },
    "starts_open": true,
    "default_width": 600,
  },
  "relative_line_numbers": "enabled",
  "scrollbar": { "show": "never" },
  "show_whitespaces": "trailing",
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true,
    "show_tab_bar_buttons": true,
  },
  "theme": {
    "mode": "system",
    "dark": "GitHub Dark",
    "light": "One Light",
  },
  "toolbar": { "quick_actions": false, "breadcrumbs": true },
  "ui_font_family": "Geist Mono",
  "ui_font_size": 15,
  "unstable.ui_density": "comfortable",
  "use_system_prompts": false,
  "vim_mode": true,
}
