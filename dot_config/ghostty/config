# Dynamic theme colors
config-file = ?"~/.config/ghostty/base.conf"

# Window
window-theme = ghostty
window-padding-x = 8
window-padding-y = 0
macos-titlebar-style = hidden
macos-option-as-alt = true
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

keybind = cmd+h=text:\x08
keybind = cmd+w=text:\x17

# Splits
keybind = option+g>h=goto_split:left
keybind = option+g>l=goto_split:right
keybind = option+g>j=goto_split:down
keybind = option+g>k=goto_split:up
keybind = option+g>/=new_split:right
keybind = option+g>-=new_split:down

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
mouse-hide-while-typing = true

background-opacity = 1.00
# theme = dark:Everforest Dark Hard,light:obsidian-ember-light
theme = dark:Github Dark High Contrast,light:Github Light High Contrast
# custom-shader = ~/.config/ghostty/shaders/cursor.glsl


